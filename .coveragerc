[run]
source = src
omit =
    */tests/*
    */__pycache__/*
    */venv/*
    */.venv/*
branch = True

[report]
precision = 2
fail_under = 80
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    if __debug__:

[html]
directory = htmlcov

[xml]
output = coverage.xml
